# Production settings for docker compose. Copy to .env on the server; never commit .env.
# Domain that points to this server (HTTPS certificate is issued automatically)
DOMAIN=kontrol.example.org
# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 48  (32+ characters)
JWT_SECRET=
# First administrator, created on the first start
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Web push keys: generate ONCE (see README) and never change them afterwards
VAPID_SUBJECT=mailto:admin@example.org
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
