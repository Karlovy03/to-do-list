# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3101
DATABASE_URL=postgresql://kontrol:CHANGE_ME@localhost:5432/kontrol
# 32+ random characters: openssl rand -base64 48
JWT_SECRET=
# Public HTTPS address of the app (web push works only over HTTPS)
PUBLIC_URL=https://kontrol.example.org
TRUST_PROXY_HOPS=1
REMINDER_TICK_MS=60000
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Web push (browser notifications): generate once with `npm run vapid`, never change afterwards
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Native apps (not used yet)
FCM_SERVICE_ACCOUNT_FILE=
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
