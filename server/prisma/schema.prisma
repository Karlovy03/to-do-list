generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // керує користувачами, структурою, довідником і налаштуваннями; бачить і керує всіма завданнями
  DIRECTOR // бачить і керує всіма завданнями, без адмінки (ADR-0012)
  MANAGER // бачить і керує завданнями своєї вертикалі підрозділів; доручає будь-кому (ADR-0012)
  MEMBER // виконує свої завдання
}

// ADR-0002: без проміжного «на прийнятті»
enum TaskStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  NORMAL
  HIGH
  URGENT
}

enum UpdateKind {
  CREATED
  COMMENT
  PROGRESS
  STATUS
  CONTROL_ON
  CONTROL_OFF
  DEADLINE
  ASSIGNEES
}

enum NotificationKind {
  ASSIGNED
  UNASSIGNED
  CONTROL_ON
  CONTROL_CHANGED
  CONTROL_OFF
  CONTROL_REMINDER
  DEADLINE_SOON
  DEADLINE_CHANGED
  OVERDUE
  PROGRESS
  COMMENT
  STARTED
  DONE_PART
  DONE
  RETURNED
  CANCELLED
  REOPENED
  EVENT_INVITED
  EVENT_CHANGED
  EVENT_CANCELLED
  EVENT_SOON
}

// Вид відсутності (ADR-0019): лише три — відрядження й навчання свідомо не заводимо
enum AbsenceKind {
  VACATION
  SICK_LEAVE
  FAMILY
}

// Стан заходу зберігається лише такий; «триває» і «минув» рахуються з часу (ADR-0016)
enum EventStatus {
  PLANNED
  CANCELLED
}

enum DevicePlatform {
  android
  ios
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  fullName     String
  position     String   @default("")
  role         Role     @default(MEMBER)
  // підрозділ задає лише адміністратор; від нього залежить вертикаль керівника (ADR-0012)
  unitId       String?
  unit         Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  isActive     Boolean  @default(true)
  // зміна пароля, ролі чи вимкнення збільшує версію — старі токени стають недійсними
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  // Особисті налаштування сповіщень (типові значення бере сервіс із загальних налаштувань)
  quietFrom          Int     @default(20)
  quietTo            Int     @default(8)
  muteWeekends       Boolean @default(true)
  notifyAssigned     Boolean @default(true)
  notifyControl      Boolean @default(true)
  notifyDeadline     Boolean @default(true)
  notifyUpdates      Boolean @default(true)
  controlInterval    Int? // хв; null = загальне налаштування
  notifyEvents       Boolean @default(true)
  // анімація «Виконано!» на контрольному завданні (ADR-0018); налаштування людини, а не пристрою
  cheerOnControlDone Boolean @default(true)

  authored            Task[]             @relation("TaskAuthor")
  controlsSet         Task[]             @relation("TaskControlSetBy")
  controlling         Task[]             @relation("TaskControllerUser")
  assignments         TaskAssignee[]
  updates             TaskUpdate[]
  notifications       Notification[]
  pushSubs            PushSubscription[]
  devices             DeviceToken[]
  reminders           ReminderLog[]
  snoozes             Snooze[]
  organizedEvents     Event[]            @relation("EventOrganizer")
  eventParticipations EventParticipant[]
  absences            Absence[]          @relation("AbsenceUser")
  absencesCreated     Absence[]          @relation("AbsenceAuthor")

  @@index([unitId])
}

// Структура: підрозділ і підрозділи, що входять у нього (будь-яка глибина)
model Unit {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  parent    Unit?    @relation("UnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Unit[]   @relation("UnitTree")
  users     User[]
  createdAt DateTime @default(now())

  @@index([parentId])
}

// Довідник осіб, які ставлять контроль, але не мають акаунта
model Controller {
  id           String   @id @default(cuid())
  fullName     String
  position     String   @default("")
  organization String   @default("")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  tasks        Task[]
}

model Task {
  id            String     @id @default(cuid())
  number        Int        @unique @default(autoincrement())
  title         String
  description   String     @default("")
  priority      Priority   @default(NORMAL)
  status        TaskStatus @default(NEW)
  progress      Int        @default(0)
  deadline      DateTime
  // від цієї миті рахуються пороги попереджень про термін
  deadlineSetAt DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?

  authorId String
  author   User   @relation("TaskAuthor", fields: [authorId], references: [id])

  // Контроль: хто зареєстрував у системі + контролююча особа (рівно одна з трьох)
  isControlled     Boolean     @default(false)
  controlSetAt     DateTime?
  controlSetById   String?
  controlSetBy     User?       @relation("TaskControlSetBy", fields: [controlSetById], references: [id])
  controllerUserId String?
  controllerUser   User?       @relation("TaskControllerUser", fields: [controllerUserId], references: [id])
  controllerId     String?
  controller       Controller? @relation(fields: [controllerId], references: [id])
  controllerText   String?
  controlBasis     String?
  reminderInterval Int? // хв; null = за налаштуваннями

  assignees     TaskAssignee[]
  updates       TaskUpdate[]
  notifications Notification[]
  reminders     ReminderLog[]
  snoozes       Snooze[]

  @@index([status, deadline])
  @@index([isControlled, status])
  @@index([authorId])
  @@index([controllerUserId])
  @@index([controllerId])
  @@index([controlSetById])
  @@index([completedAt])
  @@index([createdAt])
}

model TaskAssignee {
  taskId  String
  userId  String
  addedAt DateTime  @default(now())
  // виконавець позначив «Виконано»; завдання DONE, коли позначили всі
  doneAt  DateTime?
  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
  @@index([userId])
}

// Журнал ходу виконання
model TaskUpdate {
  id        String     @id @default(cuid())
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String? // null = дія системи
  author    User?      @relation(fields: [authorId], references: [id])
  kind      UpdateKind
  text      String     @default("")
  progress  Int?
  meta      Json?
  createdAt DateTime   @default(now())

  @@index([taskId, createdAt])
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  eventId      String?
  event        Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind         NotificationKind
  title        String
  body         String
  readAt       DateTime?
  createdAt    DateTime         @default(now())
  // push відкладено до кінця тихих годин людини (нове завдання, контроль); стрічка вже має запис
  pushDeferred Boolean          @default(false)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([pushDeferred])
  @@index([eventId])
}

// Захід: нарада, зустріч, навчання — початок і орієнтовна тривалість (ADR-0016).
// Кінець зберігається, щоб вибірка за період була одним порівнянням інтервалів.
model Event {
  id          String      @id @default(cuid())
  title       String
  description String      @default("")
  startsAt    DateTime
  endsAt      DateTime
  status      EventStatus @default(PLANNED)
  cancelledAt DateTime?
  organizerId String
  organizer   User        @relation("EventOrganizer", fields: [organizerId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  participants  EventParticipant[]
  notifications Notification[]

  @@index([startsAt])
  @@index([endsAt])
  @@index([organizerId])
}

model EventParticipant {
  eventId    String
  userId     String
  addedAt    DateTime  @default(now())
  // нагадування перед початком уже надіслано; скидається, якщо змінився час
  remindedAt DateTime?
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id])

  @@id([eventId, userId])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

// Токен мобільного застосунку (Android — FCM, iPhone — APNs)
model DeviceToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique
  platform  DevicePlatform
  // збірка розробника iOS шле через пісочницю APNs
  sandbox   Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
}

// Що й коли вже нагадали — щоб не дублювати
model ReminderLog {
  taskId String
  userId String
  key    String // control | overdue | deadline:<хв>
  sentAt DateTime @default(now())
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId, key])
  @@index([userId])
}

model Snooze {
  taskId String
  userId String
  until  DateTime
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Setting {
  key   String @id
  value Json
}

// Відсутність людини (ADR-0019): цілі дні за Києвом, кінець включно («1–9» → 10-го на службі).
// «Відсутній зараз» не зберігається — виводиться з дат; погодження немає, ставити завдання не заборонено
model Absence {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation("AbsenceUser", fields: [userId], references: [id], onDelete: Cascade)
  kind        AbsenceKind
  startDay    DateTime    @db.Date
  endDay      DateTime    @db.Date
  // хто завів: сама людина або її керівник; людина не знімає заведене керівником
  createdById String?
  createdBy   User?       @relation("AbsenceAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, startDay])
  @@index([startDay, endDay])
}
