generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // керує користувачами, довідником і загальними налаштуваннями; права керівника
  MANAGER // ставить завдання будь-кому, бере на контроль, керує всіма завданнями (ADR-0003)
  MEMBER // виконує свої завдання
}

// ADR-0002: без проміжного «на прийнятті»
enum TaskStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  NORMAL
  HIGH
  URGENT
}

enum UpdateKind {
  CREATED
  COMMENT
  PROGRESS
  STATUS
  CONTROL_ON
  CONTROL_OFF
  DEADLINE
  ASSIGNEES
}

enum NotificationKind {
  ASSIGNED
  UNASSIGNED
  CONTROL_ON
  CONTROL_CHANGED
  CONTROL_OFF
  CONTROL_REMINDER
  DEADLINE_SOON
  DEADLINE_CHANGED
  OVERDUE
  PROGRESS
  COMMENT
  STARTED
  DONE_PART
  DONE
  RETURNED
  CANCELLED
  REOPENED
}

enum DevicePlatform {
  android
  ios
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  fullName     String
  position     String   @default("")
  role         Role     @default(MEMBER)
  isActive     Boolean  @default(true)
  // зміна пароля, ролі чи вимкнення збільшує версію — старі токени стають недійсними
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  // Особисті налаштування сповіщень (типові значення бере сервіс із загальних налаштувань)
  quietFrom       Int     @default(20)
  quietTo         Int     @default(8)
  muteWeekends    Boolean @default(true)
  notifyAssigned  Boolean @default(true)
  notifyControl   Boolean @default(true)
  notifyDeadline  Boolean @default(true)
  notifyUpdates   Boolean @default(true)
  controlInterval Int? // хв; null = загальне налаштування

  authored      Task[]             @relation("TaskAuthor")
  controlsSet   Task[]             @relation("TaskControlSetBy")
  controlling   Task[]             @relation("TaskControllerUser")
  assignments   TaskAssignee[]
  updates       TaskUpdate[]
  notifications Notification[]
  pushSubs      PushSubscription[]
  devices       DeviceToken[]
  reminders     ReminderLog[]
  snoozes       Snooze[]
}

// Довідник осіб, які ставлять контроль, але не мають акаунта
model Controller {
  id           String   @id @default(cuid())
  fullName     String
  position     String   @default("")
  organization String   @default("")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  tasks        Task[]
}

model Task {
  id            String     @id @default(cuid())
  number        Int        @unique @default(autoincrement())
  title         String
  description   String     @default("")
  priority      Priority   @default(NORMAL)
  status        TaskStatus @default(NEW)
  progress      Int        @default(0)
  deadline      DateTime
  // від цієї миті рахуються пороги попереджень про термін
  deadlineSetAt DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?

  authorId String
  author   User   @relation("TaskAuthor", fields: [authorId], references: [id])

  // Контроль: хто зареєстрував у системі + контролююча особа (рівно одна з трьох)
  isControlled     Boolean     @default(false)
  controlSetAt     DateTime?
  controlSetById   String?
  controlSetBy     User?       @relation("TaskControlSetBy", fields: [controlSetById], references: [id])
  controllerUserId String?
  controllerUser   User?       @relation("TaskControllerUser", fields: [controllerUserId], references: [id])
  controllerId     String?
  controller       Controller? @relation(fields: [controllerId], references: [id])
  controllerText   String?
  controlBasis     String?
  reminderInterval Int? // хв; null = за налаштуваннями

  assignees     TaskAssignee[]
  updates       TaskUpdate[]
  notifications Notification[]
  reminders     ReminderLog[]
  snoozes       Snooze[]

  @@index([status, deadline])
  @@index([isControlled, status])
  @@index([authorId])
  @@index([controllerUserId])
  @@index([controllerId])
  @@index([controlSetById])
  @@index([completedAt])
}

model TaskAssignee {
  taskId  String
  userId  String
  addedAt DateTime  @default(now())
  // виконавець позначив «Виконано»; завдання DONE, коли позначили всі
  doneAt  DateTime?
  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
  @@index([userId])
}

// Журнал ходу виконання
model TaskUpdate {
  id        String     @id @default(cuid())
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String? // null = дія системи
  author    User?      @relation(fields: [authorId], references: [id])
  kind      UpdateKind
  text      String     @default("")
  progress  Int?
  meta      Json?
  createdAt DateTime   @default(now())

  @@index([taskId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

// Токен мобільного застосунку (Android — FCM, iPhone — APNs)
model DeviceToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique
  platform  DevicePlatform
  // збірка розробника iOS шле через пісочницю APNs
  sandbox   Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
}

// Що й коли вже нагадали — щоб не дублювати
model ReminderLog {
  taskId String
  userId String
  key    String // control | overdue | deadline:<хв>
  sentAt DateTime @default(now())
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId, key])
  @@index([userId])
}

model Snooze {
  taskId String
  userId String
  until  DateTime
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Setting {
  key   String @id
  value Json
}
